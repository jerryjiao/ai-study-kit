{
  "name": "ai-study-kit",
  "private": true,
  "version": "0.10.0",
  "description": "AI 辅助学习工具脚手架——把任意主题的题库变成完整学习闭环：课程、闪卡、错题精讲、间隔重复。",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm -C apps/quiz-app run dev",
    "build": "pnpm -C apps/quiz-app run build",
    "server": "pnpm -C apps/quiz-app run server",
    "start": "pnpm -C apps/quiz-app run start",
    "test": "pnpm -C apps/quiz-app run test && node --test apps/quiz-app/scripts/lib/*.test.mjs",
    "scan": "python3 scripts/brand-scan.py",
    "ai:teach": "node apps/quiz-app/scripts/teach-generate.mjs",
    "ai:grill": "node apps/quiz-app/scripts/grill-wrong.mjs",
    "ai:podcast": "node apps/quiz-app/scripts/podcast-generate.mjs",
    "check:alignment": "python3 scripts/bidirectional-check.py",
    "sync:plugin": "node scripts/sync-plugin.mjs",
    "skill:install": "bash scripts/install-skill.sh",
    "skill:uninstall": "bash scripts/install-skill.sh --uninstall"
  }
}
