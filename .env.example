# ai-study-kit · AI 功能配置（复制本文件为 .env 后填写）
#
# 三个 AI CLI（teach/grill/podcast）都通过这里的配置调 LLM/TTS。
# 不配置也能跑答题站（pnpm dev），只是 AI CLI 用不了。

# ═══════════════════════════════════════════════════════════
# 1. LLM Provider（必填——想用 AI CLI 就必须配）
# ═══════════════════════════════════════════════════════════
#
# 支持任何 OpenAI 兼容协议的 provider。下面给几家主流示例，任选一家。

# ── 智谱 GLM（国内推荐，便宜稳定）──
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your-glm-key-here
LLM_MODEL=glm-4.6

# ── OpenAI（海外）──
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# ── DeepSeek（国内便宜，代码强）──
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat

# ── 月之暗面 Kimi（长上下文）──
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=moonshot-v1-32k

# ── 阿里通义千问（DashScope 兼容模式）──
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=qwen-plus

# ── 字节豆包（火山方舟）──
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_API_KEY=...
# LLM_MODEL=doubao-pro-32k


# ═══════════════════════════════════════════════════════════
# 2. TTS Provider（仅 podcast-generate.mjs 需要）
# ═══════════════════════════════════════════════════════════
#
# 当前只支持 GLM-TTS（智谱）。后续会加 OpenAI TTS / ElevenLabs 等。

TTS_PROVIDER=glm-tts

# GLM-TTS 复用 LLM_API_KEY（智谱的同一 key 通 LLM 和 TTS）；用 OpenAI 等其他 LLM 时
# 这里要单配 GLM_TTS_API_KEY。
# GLM_TTS_API_KEY=your-glm-tts-key

# 男女主播音色（GLM-TTS voice 字段）。
# 默认用 generic 'male' / 'female'（API 兼容）。
# 也可用具体音色名：彤彤 / 小陈 / 锤锤 / jam / kazi / douji / luodo
# 详见 https://docs.bigmodel.cn/cn/guide/models/sound-and-video/glm-tts
TTS_MALE_VOICE=male
TTS_FEMALE_VOICE=female


# ═══════════════════════════════════════════════════════════
# 3. 可选：AI CLI 生成内容的输出语言
# ═══════════════════════════════════════════════════════════
#
# 三个 CLI（teach/grill/podcast）的生成内容语言：zh（默认）/ en / es / ru。
# 只影响生成的课程/精讲/播客内容与 HTML 固定文案；CLI 日志仍中文。
# 命令行 --lang 参数优先于此处。详见 docs/ai-cli-guide.md 的「输出语言」章节。
# STUDY_LANG=zh


# ═══════════════════════════════════════════════════════════
# 4. 可选：grill-wrong.mjs 拉错题用的服务器地址
# ═══════════════════════════════════════════════════════════
#
# 默认 http://localhost:8787（本地跑的 quiz-app 后端）。
# 改成你的线上服务器可以拉线上错题。
# SERVER=http://localhost:8787
