{
  "name": "@ai-study-kit/quiz-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "sync:examples": "node scripts/sync-examples.mjs",
    "sync:study": "node scripts/sync-study.mjs",
    "dev": "npm run sync:examples && npm run sync:study && vite",
    "build": "npm run sync:examples && npm run sync:study && tsc -b && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "start": "npm run build && npm run server",
    "test": "npm run sync:examples && vitest run",
    "test:watch": "vitest",
    "qa": "node scripts/qa_questions.mjs",
    "pm2:restart": "pm2 delete quiz-app || true; pm2 start ecosystem.config.cjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "dotenv": "^17.4.2",
    "hono": "^4.6.0",
    "lucide-react": "^1.23.0",
    "openai": "^6.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "pm2": "^7.0.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
